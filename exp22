#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd = open("log2026.txt", O_RDONLY);
    printf("File Descriptor: %d\n", fd);

    off_t pos = lseek(fd, 5, SEEK_SET);
    printf("File pointer moved to: %ld\n", pos);

    struct stat st;
    stat("log2026.txt", &st);
    printf("File Size: %ld bytes\n", st.st_size);

    DIR *d;
    struct dirent *dir;
    d = opendir(".");
    printf("Directory Listing:\n");
    while((dir = readdir(d)) != NULL)
        printf("%s\n", dir->d_name);
    closedir(d);

    close(fd);
    return 0;
}
